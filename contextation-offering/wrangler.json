{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contextation-offering",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "offering.contextation.com",
      "custom_domain": true
    }
  ],
  "send_metrics": false
}
